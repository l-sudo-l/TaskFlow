# Copiá este archivo como .env y completá los valores. El .env NO se sube al repo.

# Cadena de conexión de PostgreSQL (en producción, la de Neon)
DATABASE_URL=postgresql://usuario:clave@localhost:5432/taskflow

# Clave para firmar los tokens de sesión. En producción, una larga y al azar.
JWT_SECRET=cambiame

# Dirección del frontend, para CORS. Se pueden poner varias separadas por coma.
FRONTEND_URL=http://localhost:5173

PORT=3000
